{
  "name": "SK Hub Office Doc",
  "short_name": "Doc",
  "description": "文書を書く SK Hub Office の Doc。ファイルは PC のフォルダや Google ドライブに保存します（開発中）。",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "launch_handler": { "client_mode": ["navigate-new", "auto"] },
  "lang": "ja",
  "dir": "ltr",
  "background_color": "#faf8ff",
  "theme_color": "#2563eb",
  "categories": ["productivity", "education"],
  "icons": [
    { "src": "../icons/doc-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "../icons/doc-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "../icons/doc-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "../icons/doc-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-sk-hub-office-doc": [".skdoc"] }, "icons": [{ "src": "../icons/doc-96.png", "sizes": "96x96", "type": "image/png" }], "launch_type": "single-client" }
  ]
}
