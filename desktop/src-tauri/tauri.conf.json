{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SK Hub Office",
  "version": "0.1.0",
  "identifier": "jp.sk-hub.office",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["skdoc"], "name": "SK Hub Office Doc", "description": "SK Hub Office 文書", "mimeType": "application/x-sk-hub-office-doc", "role": "Editor" },
      { "ext": ["sksheet"], "name": "SK Hub Office Sheet", "description": "SK Hub Office 表計算", "mimeType": "application/x-sk-hub-office-sheet", "role": "Editor" },
      { "ext": ["skslide"], "name": "SK Hub Office Slide", "description": "SK Hub Office スライド", "mimeType": "application/x-sk-hub-office-slide", "role": "Editor" }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"]
      }
    }
  }
}
