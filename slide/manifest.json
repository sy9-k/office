{
  "name": "SK Hub Office Slide",
  "short_name": "Slide",
  "description": "発表をつくる SK Hub Office の Slide。ファイルは PC のフォルダや Google ドライブに保存します（開発中）。",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "launch_handler": { "client_mode": ["navigate-new", "auto"] },
  "lang": "ja",
  "dir": "ltr",
  "background_color": "#fff8f4",
  "theme_color": "#ea580c",
  "categories": ["productivity", "education"],
  "icons": [
    { "src": "../icons/slide-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "../icons/slide-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "../icons/slide-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "../icons/slide-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-sk-hub-office-slide": [".skslide"] }, "icons": [{ "src": "../icons/slide-96.png", "sizes": "96x96", "type": "image/png" }], "launch_type": "single-client" }
  ]
}
