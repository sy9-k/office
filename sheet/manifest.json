{
  "name": "SK Hub Office Sheet",
  "short_name": "Sheet",
  "description": "表で計算する SK Hub Office の Sheet。ファイルは PC のフォルダや Google ドライブに保存します（開発中）。",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "launch_handler": { "client_mode": ["navigate-new", "auto"] },
  "lang": "ja",
  "dir": "ltr",
  "background_color": "#f7faf4",
  "theme_color": "#16a34a",
  "categories": ["productivity", "education"],
  "icons": [
    { "src": "../icons/sheet-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "../icons/sheet-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "../icons/sheet-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "../icons/sheet-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-sk-hub-office-sheet": [".sksheet"] }, "icons": [{ "src": "../icons/sheet-96.png", "sizes": "96x96", "type": "image/png" }], "launch_type": "single-client" }
  ]
}
